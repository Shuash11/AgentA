# AgentA config keys — reference for --dart-define (the ONLY config source).
# CI passes these from GitHub Actions secrets as --dart-define at APK build.
# Local dev: pass the keys you need on the command line, e.g.
#   flutter run --dart-define=GROQ_API_KEY=... --dart-define=SUPABASE_URL=...
# This file is documentation only — the app never reads it or any .env file.
# Get Groq API key from https://console.groq.com (free tier available)
GROQ_API_KEY=
OPENROUTER_API_KEY=  # OpenRouter chat (AgentA 2.1 Flash + AgentA Pro, free tier) — passed via --dart-define
GEMMA_MODEL_URL=https://huggingface.co/litert-community/gemma-4-E2B-it-litert-lm/resolve/main/gemma-4-E2B-it.litertlm  # official Gemma 4 E2B bundle (LiteRT-LM engine); ungated — no HF token required
HF_TOKEN=  # optional HuggingFace read token — only needed when GEMMA_MODEL_URL points at a gated asset
# Supabase backend (https://supabase.com/dashboard/project/pmeygoyubqiaqvsuyjzm)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Google sign-in — MUST be the Web OAuth client ID (Google Cloud Console -> Credentials -> Web application).
# It ends with .apps.googleusercontent.com. See docs/google-signin-setup.md
# Do NOT use an Android client ID here — Android clients carry no secret and
# exist only to bind a SHA-1 + package com.agenta.AgentA to this Web client.
# Register every SHA-1 first: local debug (~/.android/debug.keystore), CI debug,
# release keystore, Play upload + Play signing. Unregistered SHA => ApiException 10 / instant "cancelled".
GOOGLE_SERVER_CLIENT_ID=
