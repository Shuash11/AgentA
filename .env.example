# Copy to .env for local dev. CI builds .env from gh secrets.
# Get Groq API key from https://console.groq.com (free tier available)
# Get MiniMax API key from https://www.minimaxi.com/user-center/basic-information/interface-key
# Get Kaggle API token from https://www.kaggle.com/settings/api
GROQ_API_KEY=
MINIMAX_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=
GEMMA_MODEL_URL=https://huggingface.co/AfiOne/gemma3-1b-it-int4.task/resolve/main/gemma3-1b-it-int4.task
HF_TOKEN=
# Supabase backend (https://supabase.com/dashboard/project/pmeygoyubqiaqvsuyjzm)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Google sign-in — MUST be the Web OAuth client ID (Google Cloud Console -> Credentials -> Web application).
# It ends with .apps.googleusercontent.com. See docs/google-signin-setup.md
# Do NOT use an Android client ID here — Android clients carry no secret and
# exist only to bind a SHA-1 + package com.agenta.AgentA to this Web client.
# Register every SHA-1 first: local debug (~/.android/debug.keystore), CI debug,
# release keystore, Play upload + Play signing. Unregistered SHA => ApiException 10 / instant "cancelled".
GOOGLE_SERVER_CLIENT_ID=
